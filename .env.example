# คัดลอกเป็น .env.local สำหรับรันในเครื่อง (vercel dev)
# บน Vercel ให้ใส่ค่าเหล่านี้ที่ Project Settings > Environment Variables

# ---- LINE Login channel ----
LINE_CHANNEL_ID=2001234567
LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LIFF ID ไม่บังคับ ใส่เมื่อต้องการให้เปิดจากแอป LINE แล้วเข้าสู่ระบบทันที
LIFF_ID=

# URL จริงของเว็บ ต้องตรงกับ Callback URL ใน LINE Developers
# ห้ามใส่ / ปิดท้าย ตัวอย่าง https://internet-quest.vercel.app
PUBLIC_URL=

# ---- Google Sheets ----
# รหัสสเปรดชีต ดูจาก URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# ทางเลือกที่ 1 วาง JSON ของ service account ทั้งก้อน (แนะนำบน Vercel)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ทางเลือกที่ 2 แยกเป็นสองค่า ขึ้นบรรทัดใหม่ใน private key ใช้ \n
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ---- ระบบ ----
# กุญแจสุ่มยาวอย่างน้อย 32 ตัวอักษร ใช้เซ็น cookie เซสชัน
# สร้างด้วย: openssl rand -hex 32
SESSION_SECRET=

# กุญแจสำหรับเรียก /api/setup ครั้งเดียวตอนติดตั้ง
ADMIN_KEY=
