# คัดลอกเป็น .env.local สำหรับรันในเครื่อง (vercel dev)
# บน Vercel ให้ใส่ค่าเหล่านี้ที่ Project Settings > Environment Variables

# ---- LINE Login channel ----
LINE_CHANNEL_ID=2001234567
LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LIFF ID ไม่บังคับ ใส่เมื่อต้องการให้เปิดจากแอป LINE แล้วเข้าสู่ระบบทันที
LIFF_ID=

# Channel access token ของ Messaging API channel (ของ LINE OA)
# ไม่บังคับ ใส่เมื่อต้องการให้ระบบส่งการ์ดแจ้งผลเข้าแชทของผู้เรียน
# เว้นว่าง = ไม่ส่งแจ้งเตือน ระบบส่วนอื่นทำงานปกติ
LINE_MESSAGING_TOKEN=

# Channel secret ของ Messaging API channel เดียวกัน
# ใช้ตรวจลายเซ็นของ webhook ต้องใส่ถ้าจะให้ผู้เรียนพิมพ์คุยกับบอทได้
LINE_MESSAGING_CHANNEL_SECRET=

# โดเมนจริงของเว็บ ระบบเอาไปต่อเป็น <APP_BASE_URL>/api/auth/callback
# ใส่แค่โดเมน ตัวอย่าง https://internet-quest.vercel.app
# บน Vercel ให้ตั้ง Type เป็น Config (ชื่อที่ขึ้นต้นด้วย PUBLIC_ จะตั้ง Secret ไม่ได้)
# ยังรองรับชื่อเดิม PUBLIC_URL เพื่อความเข้ากันได้
APP_BASE_URL=

# ---- Google Sheets ----
# รหัสสเปรดชีต ดูจาก URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# ทางเลือกที่ 1 วาง JSON ของ service account ทั้งก้อน (แนะนำบน Vercel)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ทางเลือกที่ 2 แยกเป็นสองค่า ขึ้นบรรทัดใหม่ใน private key ใช้ \n
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ---- ระบบ ----
# กุญแจสุ่มยาวอย่างน้อย 32 ตัวอักษร ใช้เซ็น cookie เซสชัน
# สร้างด้วย: openssl rand -hex 32
SESSION_SECRET=

# กุญแจสำหรับเรียก /api/setup ครั้งเดียวตอนติดตั้ง
ADMIN_KEY=
